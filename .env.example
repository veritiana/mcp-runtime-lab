# REQUIRED: generate with openssl rand -hex 32
MCP_ADMIN_TOKEN=replace-with-strong-random-token
MCP_AGENT_TOKEN=replace-with-a-second-strong-random-token
HOST=127.0.0.1
PORT=8787
DATA_DIR=.data
# Optional Docker lifecycle management (socket grants host-root-equivalent permissions)
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_ENABLED=true
# DOCKER_NETWORK=mcp-runtime-net
# Kubernetes adapter: in-cluster service account or explicit values:
# K8S_API_URL=https://kubernetes.default.svc
# K8S_NAMESPACE=mcp-system
# K8S_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# K8S_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# Optional K8S_BEARER_TOKEN for non-cluster dev, avoid in shell history
