{
  "name": "mcp-runtime-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server control plane, stdio process manager, Docker/Kubernetes adapters, live dashboard and benchmarks",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/*.test.mjs",
    "bench": "node benchmarks/run.mjs",
    "check": "node --check src/index.mjs && node --test tests/*.test.mjs"
  },
  "license": "Apache-2.0",
  "keywords": ["mcp", "docker", "kubernetes", "agent", "orchestration", "stdio"]
}
